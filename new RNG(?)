import tkinter as tk
import json
import random

class IntegratedRecommender:
    def __init__(self, root):
        self.root = root
        self.root.title("통합 행동 추천 프로그램")
        self.root.geometry("500x500")

        # JSON 파일 불러오기
        self.load_data()

        # 활동 ID 자동 생성
        self.assign_ids()

        # GUI 변수
        self.place_var = tk.StringVar(value="실내")
        self.motion_var = tk.StringVar(value="정적")
        self.group_var = tk.StringVar(value="혼자")

        # GUI 생성
        self.create_widgets()

        # 태그 단어 매핑 (GUI → JSON)
        self.map_dict = {
            "정적": "정적인",
            "동적": "동적인",
            "실내": "실내",
            "실외": "실외",
            "혼자": "혼자",
            "함께": "함께"
        }

    def load_data(self):
        with open("activities.json", "r", encoding="utf-8") as f:
            self.activities = json.load(f)

        with open("tags.json", "r", encoding="utf-8") as f:
            self.all_tags = json.load(f)

    def assign_ids(self):
        """activities.json에 ID 자동 부여"""
        for idx, act in enumerate(self.activities, start=1):
            act["id"] = idx

    def create_widgets(self):
        # ===== 장소 선택 =====
        tk.Label(self.root, text="실내 / 실외 선택").pack()
        tk.Radiobutton(self.root, text="실내", variable=self.place_var, value="실내").pack()
        tk.Radiobutton(self.root, text="실외", variable=self.place_var, value="실외").pack()

        # ===== 정적/동적 선택 =====
        tk.Label(self.root, text="정적 / 동적 선택").pack()
        tk.Radiobutton(self.root, text="정적", variable=self.motion_var, value="정적").pack()
        tk.Radiobutton(self.root, text="동적", variable=self.motion_var, value="동적").pack()

        # ===== 혼자/함께 선택 =====
        tk.Label(self.root, text="혼자 / 함께 선택").pack()
        tk.Radiobutton(self.root, text="혼자", variable=self.group_var, value="혼자").pack()
        tk.Radiobutton(self.root, text="함께", variable=self.group_var, value="함께").pack()

        # ===== 버튼 =====
        tk.Button(self.root, text="추천 받기", command=self.recommend).pack(pady=15)

        # ===== 결과 출력 =====
        self.result_var = tk.StringVar(value="추천 결과가 여기에 표시됩니다.")
        tk.Label(self.root, textvariable=self.result_var, wraplength=400).pack(pady=20)

    def recommend(self):
        # GUI 입력 → JSON 태그 단어로 변환
        place_tag = "#" + self.map_dict[self.place_var.get()]
        motion_tag = "#" + self.map_dict[self.motion_var.get()]
        group_tag = "#" + self.map_dict[self.group_var.get()]

        selected_tags = {place_tag, motion_tag, group_tag}

        # 활동 필터링
        filtered = [
            act for act in self.activities
            if selected_tags.issubset(set(act["tags"]))
        ]

        if not filtered:
            self.result_var.set("조건에 맞는 행동이 없습니다.")
            return

        # ID 목록 중 난수 선택
        available_ids = [act["id"] for act in filtered]
        chosen_id = random.choice(available_ids)

        # 선택된 ID의 활동 찾기
        chosen_activity = next(act for act in self.activities if act["id"] == chosen_id)

        self.result_var.set(
            f"추천 ID: {chosen_id}\n"
            f"행동: {chosen_activity['name']}"
        )


if __name__ == "__main__":
    root = tk.Tk()
    app = IntegratedRecommender(root)
    root.mainloop()
